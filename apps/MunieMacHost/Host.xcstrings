{
  "sourceLanguage": "en",
  "strings": {
    "Open Munie Host": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Munie Host"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Munie 主机"
          }
        }
      }
    },
    "Quit Munie Host": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Munie Host"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 Munie 主机"
          }
        }
      }
    },
    "Mac service running": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac service running"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 服务正在运行"
          }
        }
      }
    },
    "Mac service stopped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac service stopped"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 服务已停止"
          }
        }
      }
    },
    "Keep this Mac awake and online. Closing this window keeps the service running; quitting stops it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this Mac awake and online. Closing this window keeps the service running; quitting stops it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持这台 Mac 唤醒并联网。关闭窗口后服务继续运行；退出应用会停止服务。"
          }
        }
      }
    },
    "Native Codex executable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native Codex executable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生 Codex 可执行文件"
          }
        }
      }
    },
    "Start service": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start service"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动服务"
          }
        }
      }
    },
