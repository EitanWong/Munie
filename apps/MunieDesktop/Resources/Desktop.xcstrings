    },
    "This removes the saved key and switches to ChatGPT. API-key conversations are kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the saved key and switches to ChatGPT. API-key conversations are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除已保存的密钥并切回 ChatGPT。使用 API 密钥创建的会话将保留。"
          }
        }
      }
    },
    "OpenAI API key configured": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI API key configured"
