+//! Byte identity for a bounded, standalone rollout written under the native writer lock.
+
+use std::fs::File;
+use std::fs::OpenOptions;
+use std::io;
+use std::io::Read;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+
+use codex_protocol::ThreadId;
+use hmac::Hmac;
+use hmac::Mac;
+use serde::Deserialize;
+use serde::Serialize;
+use sha2::Digest;
+use sha2::Sha256;
+
+use crate::RolloutItem;
+
+const MAX_REPLAY_BYTES: u64 = 32 * 1024 * 1024;
+const MAX_BINDING_BYTES: u64 = 1024;
+const BINDING_VERSION: u8 = 1;
+const BINDING_DOMAIN: &[u8] = b"munie/replay-binding/v1\0";
+
+#[derive(Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct Binding {
+    version: u8,
+    thread_id: ThreadId,
+    destination: [u8; 32],
+    replay: ReplayFingerprint,
+    tag: [u8; 32],
+}
+
+impl Binding {
+    fn mac(&self, local_key: &[u8; 32]) -> Hmac<Sha256> {
+        let mut mac = Hmac::<Sha256>::new_from_slice(local_key).expect("fixed-size HMAC key");
+        mac.update(BINDING_DOMAIN);
+        mac.update(&[self.version]);
+        mac.update(self.thread_id.to_string().as_bytes());
+        mac.update(&self.destination);
+        mac.update(&self.replay.byte_count.to_be_bytes());
+        mac.update(&self.replay.sha256);
+        mac
+    }
+
+    fn authenticated(&self, thread_id: ThreadId, local_key: &[u8; 32]) -> bool {
+        self.version == BINDING_VERSION
+            && self.thread_id == thread_id
+            && self.mac(local_key).verify_slice(&self.tag).is_ok()
+    }
+}
+
+fn open_regular(path: &Path) -> io::Result<File> {
+    let mut options = OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK);
+    }
+    let file = options.open(path)?;
+    if !file.metadata()?.is_file() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "not a regular file",
+        ));
+    }
+    Ok(file)
+}
+
+fn read_binding(path: &Path) -> io::Result<Binding> {
+    let mut bytes = Vec::new();
+    open_regular(path)?
+        .take(MAX_BINDING_BYTES + 1)
+        .read_to_end(&mut bytes)?;
+    if u64::try_from(bytes.len()).unwrap_or(u64::MAX) > MAX_BINDING_BYTES {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "oversized replay binding",
+        ));
+    }
+    serde_json::from_slice(&bytes)
+        .map_err(|_| io::Error::new(io::ErrorKind::InvalidData, "invalid replay binding"))
+}
+
+/// Persist a writer-owned fingerprint in a host-private directory under the thread writer lock.
+/// Callers must obtain the key from trusted host storage and must not supply raw provider values.
+/// An existing record cannot be replaced with a different destination or while unverified.
+pub async fn write_replay_binding(
+    path: PathBuf,
+    thread_id: ThreadId,
+    destination: [u8; 32],
+    fingerprint: ReplayFingerprint,
+    local_key: [u8; 32],
+    publication_guard: impl Send + 'static,
+) -> io::Result<()> {
+    tokio::task::spawn_blocking(move || {
+        // Cancellation of the async caller must not release writer ownership mid-publication.
+        let _publication_guard = publication_guard;
+        if fingerprint.byte_count == 0 || fingerprint.byte_count > MAX_REPLAY_BYTES {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "invalid replay length",
+            ));
+        }
+        let replace = match read_binding(&path) {
+            Ok(previous)
+                if previous.authenticated(thread_id, &local_key)
+                    && previous.destination == destination
+                    && (previous.replay == fingerprint
+                        || previous.replay.byte_count < fingerprint.byte_count) =>
+            {
+                true
+            }
+            Err(error) if error.kind() == io::ErrorKind::NotFound => false,
+            _ => {
+                return Err(io::Error::new(
+                    io::ErrorKind::PermissionDenied,
+                    "replay binding cannot be replaced",
+                ));
+            }
+        };
+        let mut binding = Binding {
+            version: BINDING_VERSION,
+            thread_id,
+            destination,
+            replay: fingerprint,
+            tag: [0; 32],
+        };
+        binding.tag = binding.mac(&local_key).finalize().into_bytes().into();
+        let parent = path
+            .parent()
+            .ok_or_else(|| io::Error::other("missing binding directory"))?;
+        let mut staged = tempfile::NamedTempFile::new_in(parent)?;
+        serde_json::to_writer(&mut staged, &binding)?;
+        staged.flush()?;
+        staged.as_file().sync_all()?;
+        if replace {
+            staged.persist(&path)?;
+        } else {
+            staged.persist_noclobber(&path)?;
+        }
+        #[cfg(unix)]
+        File::open(parent)?.sync_all()?;
+        Ok(())
+    })
+    .await
+    .map_err(io::Error::other)?
+}
+
+/// Returns authenticated replay bytes and their bound destination, or no authority to send.
+/// The caller must already own the writer lock and must use the returned items, not a cached read.
+pub async fn read_bound_replay(
+    path: PathBuf,
+    binding_path: PathBuf,
+    thread_id: ThreadId,
+    local_key: [u8; 32],
+) -> io::Result<Option<BoundReplay>> {
+    tokio::task::spawn_blocking(move || {
+        let binding = match read_binding(&binding_path) {
+            Ok(binding) if binding.authenticated(thread_id, &local_key) => binding,
+            Ok(_) => return Ok(None),
+            Err(error)
+                if matches!(
+                    error.kind(),
+                    io::ErrorKind::NotFound | io::ErrorKind::InvalidData
+                ) =>
+            {
+                return Ok(None);
+            }
+            Err(error) => return Err(error),
+        };
+        Ok(
+            read_replay(&path, thread_id, binding.replay)?.map(|(items, accumulator)| {
+                BoundReplay {
+                    destination: binding.destination,
+                    items,
+                    seed: ReplaySeed { path, accumulator },
+                }
+            }),
+        )
+    })
+    .await
+    .map_err(io::Error::other)?
+}
+
+pub struct BoundReplay {
+    pub destination: [u8; 32],
+    pub items: Vec<RolloutItem>,
+    pub seed: ReplaySeed,
+}
+
+/// Only a successful authenticated read can obtain a seed for appending trusted history.
+pub struct ReplaySeed {
+    pub(crate) path: PathBuf,
+    pub(crate) accumulator: ReplayAccumulator,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct ReplayFingerprint {
+    byte_count: u64,
+    sha256: [u8; 32],
+}
+
+#[derive(Default)]
+pub(crate) struct ReplayAccumulator {
+    bytes: u64,
+    hash: Sha256,
+}
+
+impl ReplayAccumulator {
+    pub(crate) fn record(&mut self, written: &[u8]) -> Option<()> {
+        let size = self.bytes.checked_add(u64::try_from(written.len()).ok()?)?;
+        if size > MAX_REPLAY_BYTES {
+            return None;
+        }
+        self.bytes = size;
+        self.hash.update(written);
+        Some(())
+    }
+
+    pub(crate) fn fingerprint(&self) -> ReplayFingerprint {
+        ReplayFingerprint {
+            byte_count: self.bytes,
+            sha256: self.hash.clone().finalize().into(),
+        }
+    }
+}
+
+/// Verify and decode the same byte snapshot. The caller must already own the thread writer lock,
+/// and must obtain the expected fingerprint from a trusted checkpoint, never from this path.
+#[cfg(test)]
+pub(crate) async fn read_verified_replay(
+    path: PathBuf,
+    thread_id: ThreadId,
+    expected: ReplayFingerprint,
+) -> io::Result<Option<Vec<RolloutItem>>> {
+    tokio::task::spawn_blocking(move || {
+        Ok(read_replay(&path, thread_id, expected)?.map(|(items, _)| items))
+    })
+    .await
+    .map_err(io::Error::other)?
+}
+
+fn read_replay(
+    path: &Path,
+    thread_id: ThreadId,
+    expected: ReplayFingerprint,
+) -> io::Result<Option<(Vec<RolloutItem>, ReplayAccumulator)>> {
+    if expected.byte_count == 0
+        || expected.byte_count > MAX_REPLAY_BYTES
+        || path.extension().and_then(std::ffi::OsStr::to_str) != Some("jsonl")
+        || !path.symlink_metadata()?.file_type().is_file()
+    {
+        return Ok(None);
+    }
+    let file = open_regular(path)?;
+    if file.metadata()?.len() != expected.byte_count {
+        return Ok(None);
+    }
+    let mut bytes = Vec::new();
+    file.take(expected.byte_count + 1).read_to_end(&mut bytes)?;
+    let mut actual = ReplayAccumulator::default();
+    if actual.record(&bytes).is_none()
+        || actual.fingerprint() != expected
+        || !bytes.ends_with(b"\n")
+    {
+        return Ok(None);
+    }
+    let mut items = Vec::new();
+    for line in bytes[..bytes.len() - 1].split(|byte| *byte == b'\n') {
+        if items.len() >= 32_768 {
+            return Ok(None);
+        }
+        let Ok(item) = serde_json::from_slice(line).and_then(crate::decode_rollout_line) else {
+            return Ok(None);
+        };
+        items.push(item.item);
+    }
+    if !matches!(
+        items.first(),
+        Some(RolloutItem::SessionMeta(line))
+            if line.meta.id == thread_id
+                && line.meta.history_base.is_none()
+                && line.meta.forked_from_id.is_none()
+                && line.meta.parent_thread_id.is_none()
+    ) || items
+        .iter()
+        .skip(1)
+        .any(|item| matches!(item, RolloutItem::SessionMeta(_)))
+    {
+        return Ok(None);
+    }
+    Ok(Some((items, actual)))
+}
