+use std::fmt;
+use std::sync::Arc;
+use std::sync::OnceLock;
+
+use codex_http_client::HttpTransport;
+use codex_http_client::Request;
+use codex_http_client::Response;
+use codex_http_client::StreamResponse;
+use codex_http_client::TransportError;
+use http::HeaderMap;
+use http::HeaderName;
+use http::HeaderValue;
+use url::Url;
+
+use crate::munie_replay_state::ReplayState;
+use codex_thread_store::LiveThread;
+
+// Do not print provider URLs (query fields can contain credentials) or routing metadata.
+#[derive(PartialEq, Eq)]
+pub(super) struct ResponsesDestination {
+    url: Url,
+    account_route: Option<HeaderValue>,
+    account_id: Option<HeaderValue>,
+    auth_owner_generation: Option<u64>,
+}
+
+impl fmt::Debug for ResponsesDestination {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("ResponsesDestination(<redacted>)")
+    }
+}
+
+impl ResponsesDestination {
+    pub(super) fn new(
+        request_url: &str,
+        headers: &HeaderMap,
+        auth_owner_generation: Option<u64>,
+    ) -> Option<Self> {
+        let url = Url::parse(request_url).ok()?;
+        if url.scheme() != "https"
+            || url.host().is_none()
+            || !url.username().is_empty()
+            || url.password().is_some()
+            || url.fragment().is_some()
+            || headers.contains_key(http::header::HOST)
+        {
+            return None;
+        }
+        let routing_header = |name: &str| {
+            let values = headers.get_all(name);
+            let mut values = values.iter();
+            let value = values.next().cloned();
+            values.next().is_none().then_some(value)
+        };
+        Some(Self {
+            url,
+            account_route: routing_header(codex_model_provider::ACCOUNT_ROUTING_HEADER)?,
+            account_id: routing_header("chatgpt-account-id")?,
+            auth_owner_generation,
+        })
+    }
+
+    pub(super) fn bind_or_match(self, binding: &OnceLock<Self>) -> bool {
+        if let Some(existing) = binding.get() {
+            return existing == &self;
+        }
+        // set may race with another attempt. Compare the winner instead of rebinding.
+        match binding.set(self) {
+            Ok(()) => true,
+            Err(candidate) => binding.get() == Some(&candidate),
+        }
+    }
+
+    fn durable_tag(
+        &self,
+        state: &ReplayState,
+        headers: &HeaderMap,
+        configured_headers: &[HeaderName],
+        official_account: Option<&str>,
+    ) -> [u8; 32] {
+        let mut fields = vec![
+            Some(self.url.as_str().as_bytes()),
+            self.account_route.as_ref().map(HeaderValue::as_bytes),
+            self.account_id.as_ref().map(HeaderValue::as_bytes),
+        ];
+        let stable_official_owner = official_account.is_some_and(|account| {
+            self.url
+                .host_str()
+                .is_some_and(codex_http_client::is_allowed_chatgpt_host)
+                && self.account_id.as_ref().map(HeaderValue::as_bytes) == Some(account.as_bytes())
+        });
+        let mut names = configured_headers.to_vec();
+        names.extend([
+            HeaderName::from_static("openai-organization"),
+            HeaderName::from_static("openai-project"),
+            HeaderName::from_static("x-api-key"),
+            HeaderName::from_static("api-key"),
+        ]);
+        if !stable_official_owner {
+            names.push(http::header::AUTHORIZATION);
+        }
+        names.sort_unstable_by(|a, b| a.as_str().cmp(b.as_str()));
+        names.dedup();
+        for name in &names {
+            fields.push(None);
+            fields.push(Some(name.as_str().as_bytes()));
+            fields.extend(
+                headers
+                    .get_all(name)
+                    .iter()
+                    .map(|value| Some(value.as_bytes())),
+            );
+        }
+        state.destination_tag(&fields)
+    }
+}
+
+pub(super) struct DurableReplay {
+    state: ReplayState,
+    thread: LiveThread,
+    expected: Option<[u8; 32]>,
+    prepared: tokio::sync::OnceCell<[u8; 32]>,
+}
+
+impl fmt::Debug for DurableReplay {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("DurableReplay(<private>)")
+    }
+}
+
+impl DurableReplay {
+    pub(super) fn new(state: ReplayState, thread: LiveThread, expected: Option<[u8; 32]>) -> Self {
+        Self {
+            state,
+            thread,
+            expected,
+            prepared: tokio::sync::OnceCell::new(),
+        }
+    }
+
+    pub(super) async fn prepare(&self, destination: [u8; 32]) -> Result<(), TransportError> {
+        if self
+            .expected
+            .is_some_and(|expected| expected != destination)
+        {
+            return Err(TransportError::Build(
+                "Munie's Responses destination changed".into(),
+            ));
+        }
+        let bound = self
+            .prepared
+            .get_or_try_init(|| async {
+                self.checkpoint(destination).await?;
+                Ok::<_, std::io::Error>(destination)
+            })
+            .await
+            .map_err(|_| {
+                TransportError::Build("Munie could not persist the Responses destination".into())
+            })?;
+        if *bound != destination {
+            return Err(TransportError::Build(
+                "Munie's Responses destination changed".into(),
+            ));
+        }
+        Ok(())
+    }
+
+    async fn checkpoint(&self, destination: [u8; 32]) -> std::io::Result<()> {
+        let (path, key) = self.state.location();
+        if !self
+            .thread
+            .checkpoint_binding(path.to_path_buf(), *key, destination)
+            .await
+            .map_err(std::io::Error::other)?
+        {
+            return Err(std::io::Error::other("Munie rollout cannot be bound"));
+        }
+        Ok(())
+    }
+
+    pub(super) async fn checkpoint_after_flush(&self) -> std::io::Result<()> {
+        if let Some(destination) = self.prepared.get().copied() {
+            self.checkpoint(destination).await?;
+        }
+        Ok(())
+    }
+}
+
+pub(super) struct ResponsesTransport<T> {
+    inner: T,
+    binding: Option<Arc<OnceLock<ResponsesDestination>>>,
+    auth_owner_generation: Option<u64>,
+    durable: Option<Arc<DurableReplay>>,
+    configured_headers: Vec<HeaderName>,
+    official_account: Option<String>,
+}
+
+impl<T: HttpTransport> ResponsesTransport<T> {
+    pub(super) fn new(
+        inner: T,
+        binding: Option<Arc<OnceLock<ResponsesDestination>>>,
+        auth_owner_generation: Option<u64>,
+    ) -> Self {
+        Self {
+            inner,
+            binding,
+            auth_owner_generation,
+            durable: None,
+            configured_headers: Vec::new(),
+            official_account: None,
+        }
+    }
+
+    pub(super) fn with_durable_replay(mut self, replay: Option<Arc<DurableReplay>>) -> Self {
+        self.durable = replay;
+        self
+    }
+
+    pub(super) fn with_routing_identity(
+        mut self,
+        configured_headers: Vec<HeaderName>,
+        official_account: Option<String>,
+    ) -> Self {
+        self.configured_headers = configured_headers;
+        self.official_account = official_account;
+        self
+    }
+
+    async fn verify(&self, request: &Request) -> Result<(), TransportError> {
+        let Some(binding) = &self.binding else {
+            return Ok(());
+        };
+        let Some(destination) =
+            ResponsesDestination::new(&request.url, &request.headers, self.auth_owner_generation)
+        else {
+            return Err(TransportError::Build(
+                "Munie cannot verify the Responses destination".into(),
+            ));
+        };
+        let tag = self.durable.as_ref().map(|replay| {
+            destination.durable_tag(
+                &replay.state,
+                &request.headers,
+                &self.configured_headers,
+                self.official_account.as_deref(),
+            )
+        });
+        if let (Some(replay), Some(tag)) = (&self.durable, tag)
+            && replay.expected.is_some_and(|expected| expected != tag)
+        {
+            return Err(TransportError::Build(
+                "Munie's Responses destination changed".into(),
+            ));
+        }
+        if !destination.bind_or_match(binding) {
+            return Err(TransportError::Build(
+                "Munie's Responses destination changed".into(),
+            ));
+        }
+        if let (Some(replay), Some(tag)) = (&self.durable, tag) {
+            replay.prepare(tag).await?;
+        }
+        Ok(())
+    }
+}
+
+impl<T: HttpTransport> HttpTransport for ResponsesTransport<T> {
+    async fn execute(&self, request: Request) -> Result<Response, TransportError> {
+        self.verify(&request).await?;
+        self.inner.execute(request).await
+    }
+
+    async fn stream(&self, request: Request) -> Result<StreamResponse, TransportError> {
+        self.verify(&request).await?;
+        self.inner.stream(request).await
+    }
+}
+
