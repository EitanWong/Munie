+pub(crate) async fn checkpoint_binding(
+    store: &LocalThreadStore,
+    thread_id: ThreadId,
+    binding_path: PathBuf,
+    key: [u8; 32],
+    destination: [u8; 32],
+) -> ThreadStoreResult<bool> {
+    let live_writer_guard = store.live_writer_locks.lock(thread_id).await;
+    let (recorder, rollout_id, _) = live_writer_parts(store, thread_id).await?;
+    if rollout_id != thread_id {
+        return Ok(false);
+    }
+    let Some(fingerprint) = recorder
+        .munie_replay_fingerprint()
+        .await
+        .map_err(thread_store_io_error)?
+    else {
+        return Ok(false);
+    };
+    codex_rollout::write_replay_binding(
+        binding_path,
+        thread_id,
+        destination,
+        fingerprint,
+        key,
+        live_writer_guard,
+    )
+    .await
+    .map_err(thread_store_io_error)?;
+    Ok(true)
 }
 
