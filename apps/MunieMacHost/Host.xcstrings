    "The operation failed. Check your local Codex login, executable, HTTPS address and service state, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation failed. Check your local Codex login, executable, HTTPS address and service state, then try again."
