        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你"
          }
        }
      }
    },
    "Your Codex account stays on the Mac. The Mac must be awake and reachable to run tasks.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Codex account stays on the Mac. The Mac must be awake and reachable to run tasks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Codex 账户保留在 Mac 上。执行任务时，Mac 必须保持唤醒且网络可达。"
          }
        }
      }
    },
    "Your Mac, with you": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac, with you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随身掌控你的 Mac"
          }
        }
      }
    },
    "Your request is saved on this iPhone. Refresh checks whether the Mac accepted it. Reconnect never sends it automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your request is saved on this iPhone. Refresh checks whether the Mac accepted it. Reconnect never sends it automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的请求已保存在此 iPhone 上。刷新可核对 Mac 是否已接受请求。重新连接不会自动发送请求。"
          }
        }
      }
    },
    "Camera scanning unavailable": {
