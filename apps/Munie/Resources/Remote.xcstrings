          }
        }
      }
    },
    "Munie can notify you when it observes completion, failure, or a pending approval. Alerts hide task content.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie can notify you when it observes completion, failure, or a pending approval. Alerts hide task content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie 检测到完成、失败或待审批状态时可通知你。提醒不会显示任务内容。"
          }
        }
      }
    },
