    },
    "Cancel pairing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel pairing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消配对"
          }
        }
      }
    },
    "Compare this fingerprint on your iPhone. Confirming grants access and control only to the selected projects.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare this fingerprint on your iPhone. Confirming grants access and control only to the selected projects."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请核对此指纹与 iPhone 上显示的一致。确认后，此设备只能访问和控制所选项目。"
          }
        }
      }
    },
    "Confirm this iPhone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm this iPhone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
