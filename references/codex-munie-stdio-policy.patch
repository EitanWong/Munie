+async fn trusted_rollout_path(store: &LocalThreadStore, stored: &Path, requested: &Path) -> bool {
+    let Ok(home) = tokio::fs::canonicalize(&store.config.codex_home).await else {
+        return false;
+    };
+    let Ok(stored) = tokio::fs::canonicalize(stored).await else {
+        return false;
+    };
+    stored == requested
+        && [
+            codex_rollout::SESSIONS_SUBDIR,
+            codex_rollout::ARCHIVED_SESSIONS_SUBDIR,
+        ]
+        .iter()
+        .any(|directory| stored.starts_with(home.join(directory)))
+}
