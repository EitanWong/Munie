            "state": "translated",
            "value": "配对允许你的 iPhone 连接，但不代表 iPhone 当前在线。"
          }
        }
      }
    },
    "More than one pairing was found. Removing pairing clears all of them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than one pairing was found. Removing pairing clears all of them."
