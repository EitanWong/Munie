    },
    "Check Mac first": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Mac first"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先核对 Mac 状态"
          }
        }
      }
    },
    "Check the request. Use 32,768 UTF-8 bytes or fewer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the request. Use 32,768 UTF-8 bytes or fewer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查请求内容，长度不得超过 32,768 个 UTF-8 字节。"
          }
        }
      }
    },
    "Checking connection…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking connection…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查连接…"
