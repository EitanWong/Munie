+/// Restricted Munie cannot run the independent Guardian scoring transports. The
+/// admitted plan and live administrator constraints must both permit proceeding.
+pub(crate) async fn enforce_munie_guardian_scoring(
+    session: &Session,
+    turn: &TurnContext,
+    model: &ModelInfo,
+) -> CodexResult<()> {
+    if !codex_protocol::shell_environment::external_extensions_disabled_for_process() {
+        return Ok(());
+    }
+    check_guardian_scoring_available(&turn.config, model, /*restricted*/ true)?;
+    let live_config = session.get_config().await;
+    if !std::ptr::eq(turn.config.as_ref(), live_config.as_ref()) {
+        check_guardian_scoring_available(&live_config, model, /*restricted*/ true)?;
+    }
+    Ok(())
+}
+
+fn check_guardian_scoring_available(
+    config: &crate::config::Config,
+    model: &ModelInfo,
+    restricted: bool,
+) -> CodexResult<()> {
+    if !restricted || !config.features.enabled(Feature::GuardianApproval) {
+        return Ok(());
+    }
+    let layers = &config.config_layer_stack;
+    let mut legacy =
+        GuardianPolicyLoader::legacy_config(&layers.effective_config()).map_err(|_| {
+            CodexErr::Fatal(
+                "Munie cannot verify the Guardian scoring policy for this turn".to_string(),
+            )
+        })?;
+    legacy.enabled = Some(config.features.enabled(Feature::GuardianV2));
+    let requirements = layers.requirements();
+    let policy = GuardianPolicyLoader::new(Some(&FeatureToml::Config(legacy)), requirements)
+        .resolve_effective(Some(model), requirements);
+    // GuardianModelPolicy::scoring_enabled checks approval scopes, but tools
+    // without a scope can also be adaptive.
+    if policy.scoring_enabled()
+        || policy.other_tools == codex_protocol::openai_models::GuardianReviewMode::Adaptive
+    {
+        return Err(CodexErr::Fatal(
+            "Munie cannot run this turn because its Guardian scoring policy is unavailable"
+                .to_string(),
+        ));
+    }
+    Ok(())
 }
 
