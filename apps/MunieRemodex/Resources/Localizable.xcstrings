            "state": "translated",
            "value": "Available"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用"
          }
        }
      }
    },
    "Open Munie": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Munie"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Munie"
          }
        }
      }
    },
    "Brings Munie to the foreground.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings Munie to the foreground."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在前台打开 Munie。"
          }
        }
      }
    },
    "Open-source licenses": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open-source licenses"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开源许可证"
          }
        }
      }
    },
    "Licenses could not be loaded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Licenses could not be loaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载许可证。"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Scan the Munie QR code": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the Munie QR code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描 Munie 二维码"
          }
        }
      }
    },
    "Chats for this project will be deleted only from Munie on this phone. Nothing is removed from your device or Codex observer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats for this project will be deleted only from Munie on this phone. Nothing is removed from your device or Codex observer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删除此手机上 Munie 内的项目会话，不会移除设备或 Codex 中的内容。"
          }
        }
      }
    },
    "This only removes the chat from Munie on this phone. Nothing is removed from your device or Codex observer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only removes the chat from Munie on this phone. Nothing is removed from your device or Codex observer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删除此手机上 Munie 内的会话，不会移除设备或 Codex 中的内容。"
          }
        }
      }
    },
    "About Munie": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About Munie"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于 Munie"
          }
        }
      }
    },
    "This only removes the chat from Munie on this phone. Nothing is removed from your Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only removes the chat from Munie on this phone. Nothing is removed from your Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删除此手机上 Munie 内的会话，不会移除 Mac 上的内容。"
          }
        }
      }
    },
    "Run these in Terminal on your paired Mac when you need to start, repair, or inspect the local Munie bridge.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run these in Terminal on your paired Mac when you need to start, repair, or inspect the local Munie bridge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要启动、修复或检查本地 Munie 桥接时，请在已配对 Mac 的终端中运行这些命令。"
          }
        }
      }
    },
    "Install the latest Munie build on this iPhone, then come back here and reconnect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the latest Munie build on this iPhone, then come back here and reconnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 iPhone 上安装最新 Munie，然后返回此处重新连接。"
          }
        }
      }
    },
    "Run these in an Administrator PowerShell on the Windows PC, then create a terminal profile in Munie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run these in an Administrator PowerShell on the Windows PC, then create a terminal profile in Munie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Windows PC 的管理员 PowerShell 中运行这些命令，然后在 Munie 中创建终端配置。"
          }
        }
      }
    },
    "SSH is the secure tunnel Munie uses to reach your Mac or PC. You need an address, a username, SSH enabled, and a private key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH is the secure tunnel Munie uses to reach your Mac or PC. You need an address, a username, SSH enabled, and a private key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie 通过 SSH 安全隧道连接 Mac 或 PC。需要地址、用户名、已启用的 SSH 和私钥。"
          }
        }
      }
    },
    "Munie cannot tell if Codex received them. Check the chat on your Mac first: sending them again could create a duplicate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie cannot tell if Codex received them. Check the chat on your Mac first: sending them again could create a duplicate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie 无法确定 Codex 是否已收到。请先检查 Mac 上的会话，重复发送可能造成重复请求。"
          }
        }
      }
    },
    "Munie will force close and reopen Codex.app on this device. Any desktop runs in progress will be stopped, and unsaved draft text there may be lost before this chat is opened.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie will force close and reopen Codex.app on this device. Any desktop runs in progress will be stopped, and unsaved draft text there may be lost before this chat is opened."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie 将强制关闭并重新打开执行设备上的 Codex.app。进行中的桌面任务将停止，打开此会话前未保存的草稿可能丢失。"
          }
        }
      }
    },
    "UI fixture": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UI fixture"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面测试"
          }
        }
      }
    },
    "Munie is thinking": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie is thinking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie 正在思考"
          }
        }
      }
    },
    "Munie does not keep a separate GPT voice secret on the iPhone. It uses the ChatGPT session already active on your paired device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie does not keep a separate GPT voice secret on the iPhone. It uses the ChatGPT session already active on your paired device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie 不会在 iPhone 上保存单独的 GPT 语音密钥，而使用已配对设备上的 ChatGPT 会话。"
          }
        }
      }
    },
    "New Munie task": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Munie task"
