+//! Thread-scoped access to Munie's private replay state. Never store provider credentials here.
+
+use std::fmt;
+use std::io;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use codex_protocol::ThreadId;
+use hmac::Hmac;
+use hmac::Mac;
+use sha2::Sha256;
+
+#[derive(Clone)]
+pub(crate) struct ReplayState {
+    path: PathBuf,
+    key: Arc<[u8; 32]>,
+}
+
+impl fmt::Debug for ReplayState {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("ReplayState(<private>)")
+    }
+}
+
+impl ReplayState {
+    pub(crate) async fn from_host(thread_id: ThreadId) -> Option<Self> {
+        if !codex_protocol::shell_environment::external_extensions_disabled_for_process() {
+            return None;
+        }
+        let root = PathBuf::from(std::env::var_os("MUNIE_HOST_STATE_DIR")?);
+        tokio::task::spawn_blocking(move || Self::open(root, thread_id))
+            .await
+            .ok()?
+            .ok()
+    }
+
+    pub(crate) fn location(&self) -> (&std::path::Path, &[u8; 32]) {
+        (&self.path, &self.key)
+    }
+
+    pub(crate) fn destination_tag(&self, fields: &[Option<&[u8]>]) -> [u8; 32] {
+        let mut hmac = Hmac::<Sha256>::new_from_slice(self.key.as_ref()).expect("fixed-size key");
+        hmac.update(b"munie/responses-destination/v1\0");
+        for field in fields {
+            if let Some(value) = field {
+                hmac.update(&[1]);
+                hmac.update(&(value.len() as u64).to_be_bytes());
+                hmac.update(value);
+            } else {
+                hmac.update(&[0]);
+            }
+        }
+        hmac.finalize().into_bytes().into()
+    }
+
+    #[cfg(unix)]
+    pub(crate) fn open(root: PathBuf, thread_id: ThreadId) -> io::Result<Self> {
+        use std::fs;
+        use std::io::Read;
+        use std::io::Write;
+        use std::os::unix::fs::DirBuilderExt;
+        use std::os::unix::fs::MetadataExt;
+        use std::os::unix::fs::OpenOptionsExt;
+
+        // The bridge supplies its canonical, already sandbox-denied private state directory.
+        let denied = || io::Error::new(io::ErrorKind::PermissionDenied, "invalid Munie state");
+        // SAFETY: geteuid takes no arguments and has no memory effects.
+        let uid = unsafe { libc::geteuid() };
+        let private = |name: &std::path::Path| -> io::Result<()> {
+            let meta = fs::symlink_metadata(name)?;
+            if !meta.is_dir() || meta.uid() != uid || meta.mode() & 0o077 != 0 {
+                return Err(denied());
+            }
+            Ok(())
+        };
+        if !root.is_absolute() || root.canonicalize()? != root {
+            return Err(denied());
+        }
+        private(&root)?;
+        let state = root.join("provider-replay-v1");
+        match fs::DirBuilder::new().mode(0o700).create(&state) {
+            Ok(()) => fs::File::open(&root)?.sync_all()?,
+            Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {}
+            Err(error) => return Err(error),
+        }
+        private(&state)?;
+
+        let key_path = state.join("key");
+        let read_key = || {
+            let mut file = fs::OpenOptions::new()
+                .read(true)
+                .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+                .open(&key_path)?;
+            let meta = file.metadata()?;
+            if !meta.is_file() || meta.uid() != uid || meta.mode() & 0o077 != 0 || meta.len() != 32
+            {
+                return Err(denied());
+            }
+            let mut key = [0; 32];
+            file.read_exact(&mut key)?;
+            if file.read(&mut [0])? != 0 {
+                return Err(denied());
+            }
+            Ok(key)
+        };
+        let key = match read_key() {
+            Ok(key) => key,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                let key = rand::random::<[u8; 32]>();
+                let mut staged = tempfile::NamedTempFile::new_in(&state)?;
+                staged.write_all(&key)?;
+                staged.as_file().sync_all()?;
+                match staged.persist_noclobber(&key_path) {
+                    Ok(_) => fs::File::open(&state)?.sync_all()?,
+                    Err(error) if error.error.kind() == io::ErrorKind::AlreadyExists => {}
+                    Err(error) => return Err(error.error),
+                }
+                read_key()?
+            }
+            Err(error) => return Err(error),
+        };
+        Ok(Self {
+            path: state.join(format!("{thread_id}.json")),
+            key: Arc::new(key),
+        })
+    }
+
+    #[cfg(not(unix))]
+    pub(crate) fn open(_root: PathBuf, _thread_id: ThreadId) -> io::Result<Self> {
+        Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "Munie replay state needs private Unix storage",
+        ))
+    }
+}
+
+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::PermissionsExt;
+
+    fn private_root() -> io::Result<tempfile::TempDir> {
+        tempfile::Builder::new()
+            .permissions(std::fs::Permissions::from_mode(0o700))
+            .tempdir()
+    }
+
+    #[test]
+    fn private_state_reopens_with_stable_and_domain_separated_destination_tags() -> io::Result<()> {
+        let root = private_root()?;
+        let root = root.path().canonicalize()?;
+        let id = ThreadId::new();
+        let authority = ReplayState::open(root.clone(), id)?;
+        let reopened = ReplayState::open(root.clone(), id)?;
+        let hashes =
+            |state: &ReplayState| state.destination_tag(&[Some(b"endpoint"), Some(b"account")]);
+        assert_eq!(hashes(&authority), hashes(&reopened));
+        assert_ne!(
+            hashes(&authority),
+            reopened.destination_tag(&[Some(b"endpoint"), None])
+        );
+        assert_ne!(
+            hashes(&authority),
+            reopened.destination_tag(&[Some(b"endpointaccount"), Some(b"")])
+        );
+        assert_ne!(
+            authority.location().0,
+            ReplayState::open(root, ThreadId::new())?.location().0
+        );
+        Ok(())
+    }
+
+    #[test]
+    fn private_state_never_follows_or_replaces_a_key_link() -> io::Result<()> {
+        let root = private_root()?;
+        let root = root.path().canonicalize()?;
+        let id = ThreadId::new();
+        let state = ReplayState::open(root.clone(), id)?;
+        let key = state.path.with_file_name("key");
+        let other = key.with_file_name("other");
+        std::fs::rename(&key, &other)?;
+        std::os::unix::fs::symlink(&other, &key)?;
+        assert!(ReplayState::open(root, id).is_err());
+        assert!(key.symlink_metadata()?.file_type().is_symlink());
+        Ok(())
+    }
+}
