{
  "sourceLanguage": "en",
  "strings": {
    "A command finished.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A command finished."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一条命令已结束。"
          }
        }
      }
    },
    "A task completed. Open Munie to inspect the result.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task completed. Open Munie to inspect the result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一项任务已完成。打开 Munie 查看结果。"
          }
        }
      }
    },
    "A task failed. Open Munie to inspect the result.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task failed. Open Munie to inspect the result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一项任务失败了。打开 Munie 查看结果。"
          }
        }
      }
    },
    "A task needs your approval. Open Munie to inspect the action.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task needs your approval. Open Munie to inspect the action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一项任务需要你审批。打开 Munie 查看具体操作。"
          }
        }
      }
    },
    "A task notice could not be scheduled. The task remains available in Munie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task notice could not be scheduled. The task remains available in Munie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安排任务通知。你仍可在 Munie 中查看任务。"
          }
        }
      }
    },
    "A task or request is already in progress. Check its state before trying again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task or request is already in progress. Check its state before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有任务或请求正在进行。请先查看其状态再重试。"
          }
        }
      }
    },
    "Accepted by Mac": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepted by Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 已接受"
          }
        }
      }
    },
    "Access was denied. Check pairing on the Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access was denied. Check pairing on the Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问被拒绝。请在 Mac 上检查配对。"
          }
        }
      }
    },
    "Add “New Munie task” in Shortcuts. On supported iPhones, assign that shortcut to the Action button. Unlock to review and submit; the shortcut does not start recording or approve actions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add “New Munie task” in Shortcuts. On supported iPhones, assign that shortcut to the Action button. Unlock to review and submit; the shortcut does not start recording or approve actions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“快捷指令”中添加“新建 Munie 任务”。支持的 iPhone 可将它设为操作按钮的快捷指令。请解锁后检查并提交；快捷指令不会开始录音或批准操作。"
          }
        }
      }
    },
    "Approve once": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve once"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅批准这一次"
          }
        }
      }
    },
    "Approve only if you understand this exact command and its working directory.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve only if you understand this exact command and its working directory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你理解这条完整命令及其工作目录后，才应批准。"
          }
        }
      }
    },
    "Authorized project": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorized project"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权项目"
          }
        }
      }
    },
    "Background alerts are unavailable. Open Munie to check task updates.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background alerts are unavailable. Open Munie to check task updates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台提醒暂不可用。请打开 Munie 查看任务更新。"
          }
        }
      }
    },
    "Cancel pairing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel pairing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消配对"
          }
        }
      }
    },
    "Cancel task": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel task"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消任务"
          }
        }
      }
    },
    "Cancellation requested — waiting for Mac confirmation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellation requested — waiting for Mac confirmation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已请求取消——等待 Mac 确认"
