{
  "sourceLanguage": "en",
  "strings": {
    "Model provider configured on Mac": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Model provider configured on Mac" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "Mac 已配置模型服务" } }
      }
    },
    "Working directory: %@": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Working directory: %@" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "工作目录：%@" } }
      }
    },
    "Send not confirmed. Check this chat on your Mac before sending again.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Send not confirmed. Check this chat on your Mac before sending again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "发送未确认。请在 Mac 上查看此对话，再决定是否重发。" } }
      }
    },
    "Self-hosted Munie": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Self-hosted Munie"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自托管 Munie"
          }
        }
      }
    },
    "All client features are available without a subscription.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All client features are available without a subscription."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需订阅即可使用全部客户端功能。"
          }
        }
      }
    },
    "Access": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
