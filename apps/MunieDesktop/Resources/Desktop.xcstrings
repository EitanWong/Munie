    "Connect this Mac to Wi-Fi or Ethernet, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect this Mac to Wi-Fi or Ethernet, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将这台 Mac 接入 Wi-Fi 或以太网，然后重试。"
          }
        }
      }
    },
    "Account status is unavailable. You can try signing in again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account status is unavailable. You can try signing in again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法获取账户状态，你可以尝试重新登录。"
          }
        }
      }
    },
    "Your iPhone is waiting for confirmation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone is waiting for confirmation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iPhone 正在等待确认"
          }
        }
      }
    },
    "iPhone confirmation needed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone confirmation needed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要确认 iPhone 连接"
          }
        }
      }
    },
    "Changing projects restarts the Mac service and may stop active work.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing projects restarts the Mac service and may stop active work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换项目会重新启动 Mac 服务，并可能停止正在执行的工作。"
          }
        }
      }
    },
    "Remove iPhone Pairing?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove iPhone Pairing?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 iPhone 配对？"
          }
        }
      }
    },
    "Remove Pairing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Pairing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除配对"
          }
        }
      }
    },
    "Keep Pairing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Pairing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留配对"
          }
        }
      }
    },
    "This removes all current iPhone pairings and disconnects them. The Mac service restarts and active work may stop. Pair again to reconnect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes all current iPhone pairings and disconnects them. The Mac service restarts and active work may stop. Pair again to reconnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除当前所有 iPhone 配对并断开连接。Mac 服务将重新启动，正在执行的工作可能停止。重新配对后才能再次连接。"
          }
        }
      }
    },
    "Paired iPhone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired iPhone"
          }
        },
        "zh-Hans": {
