      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac connection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 连接"
          }
        }
      }
    },
    "Authorize a project folder…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorize a project folder…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权项目文件夹…"
          }
        }
      }
    },
    "Projects for this iPhone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Projects for this iPhone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许此 iPhone 访问的项目"
          }
        }
      }
    },
    "Tailscale HTTPS address": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale HTTPS address"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale HTTPS 地址"
          }
        }
      }
    },
    "Use Tailscale Serve on this Mac to proxy HTTPS to 127.0.0.1:9274. Pair only over your private tailnet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Tailscale Serve on this Mac to proxy HTTPS to 127.0.0.1:9274. Pair only over your private tailnet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上使用 Tailscale Serve，将 HTTPS 转发至 127.0.0.1:9274。仅通过你的私有 tailnet 配对。"
          }
        }
      }
    },
    "Create pairing invitation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create pairing invitation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建配对邀请"
          }
        }
      }
    },
    "Invitation expires after two minutes. Treat it as private.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitation expires after two minutes. Treat it as private."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请两分钟后失效，请妥善保密。"
          }
        }
      }
    },
    "Manual pairing invitation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual pairing invitation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动配对邀请"
          }
