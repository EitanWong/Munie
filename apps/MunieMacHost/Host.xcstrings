    "Remove Munie history…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Munie history…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 Munie 历史…"
          }
        }
      }
    },
    "Remove this task from Munie?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this task from Munie?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Munie 移除此任务？"
          }
        }
      }
    },
    "Remove history": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除历史"
          }
        }
      }
    },
    "This removes Munie’s local conversation. Native Codex history remains on this Mac. Request identities stay reserved to prevent a deleted task from running again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes Munie’s local conversation. Native Codex history remains on this Mac. Request identities stay reserved to prevent a deleted task from running again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将移除 Munie 的本地对话。原生 Codex 历史仍保留在这台 Mac 上。请求标识会继续保留，防止已删除的任务被再次执行。"
          }
        }
      }
    },
    "Service cleanup not confirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Service cleanup not confirmed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务清理尚未确认"
          }
        }
      }
    },
    "Starting Mac service…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting Mac service…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在启动 Mac 服务…"
          }
        }
      }
    },
    "Stopping Mac service…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping Mac service…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在停止 Mac 服务…"
          }
        }
      }
    },
    "Retry stopping service": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry stopping service"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试停止服务"
          }
        }
      }
    },
    "The service has stopped accepting connections, but Codex cleanup is not confirmed. Retry stopping before restarting or quitting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service has stopped accepting connections, but Codex cleanup is not confirmed. Retry stopping before restarting or quitting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务已停止接受连接，但尚未确认 Codex 已完成清理。请先重试停止服务，再重新启动或退出。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
