{
  "sourceLanguage": "en",
  "strings": {
    "Mac service stopped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac service stopped"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 服务已停止"
          }
        }
      }
    },
    "Starting Munie…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting Munie…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在启动 Munie…"
          }
        }
      }
    },
    "Ready for your iPhone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready for your iPhone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可连接你的 iPhone"
          }
        }
      }
    },
    "Stopping Munie…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping Munie…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在停止 Munie…"
          }
        }
      }
    },
    "Munie needs attention": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie needs attention"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie 需要处理"
          }
        }
      }
    },
    "Stopping needs another try": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping needs another try"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重试停止"
          }
        }
      }
    },
    "Munie could not start. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie could not start. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie 无法启动，请重试。"
          }
        }
      }
    },
    "Munie could not confirm that all work stopped. Retry before quitting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie could not confirm that all work stopped. Retry before quitting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie 尚无法确认所有工作均已停止。请重试后再退出。"
          }
        }
      }
    },
    "Munie could not refresh its status. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie could not refresh its status. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法刷新 Munie 状态，请重试。"
          }
        }
      }
    },
    "Sign-in could not start. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in could not start. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始登录，请重试。"
          }
        }
      }
    },
    "Sign-in could not be cancelled. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in could not be cancelled. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法取消登录，请重试。"
          }
        }
      }
    },
    "This project could not be selected. Try another folder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This project could not be selected. Try another folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法选择此项目，请尝试其他文件夹。"
          }
        }
      }
    },
    "Pairing did not finish. Keep both apps open and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing did not finish. Keep both apps open and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对未完成。请保持两端 App 打开并重试。"
          }
        }
      }
    },
    "The sign-in page could not open. Try opening it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in page could not open. Try opening it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开登录页面，请重试。"
          }
        }
      }
    },
    "Munie stopped unexpectedly. Cleanup must be confirmed before restarting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie stopped unexpectedly. Cleanup must be confirmed before restarting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie 意外停止。需要先确认清理完成，才能重新启动。"
          }
        }
      }
    },
    "Munie lost its local connection. Retry stopping before restarting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie lost its local connection. Retry stopping before restarting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie 与本地服务的连接已中断。请先重试停止，再重新启动。"
          }
        }
      }
    },
    "Use Project": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Project"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用项目"
          }
        }
      }
    },
    "Your account": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账户"
          }
        }
      }
    },
    "Your Codex account stays on this Mac. Munie never sends account credentials to your iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Codex account stays on this Mac. Munie never sends account credentials to your iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 账户保留在这台 Mac 上。Munie 不会向 iPhone 发送账户凭据。"
          }
        }
      }
    },
    "Signed in to Codex": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed in to Codex"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已登录 Codex"
          }
        }
      }
    },
    "Finish signing in in your browser, then return to Munie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish signing in in your browser, then return to Munie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在浏览器中完成登录，然后返回 Munie。"
          }
        }
      }
    },
    "Open Sign-In Page": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Sign-In Page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开登录页面"
          }
        }
      }
    },
    "Cancel Sign-In": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel Sign-In"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消登录"
          }
        }
      }
    },
    "Sign in to use Codex from your iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to use Codex from your iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后，即可从 iPhone 使用 Codex。"
          }
        }
      }
    },
    "Sign In to Codex": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign In to Codex"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录 Codex"
          }
        }
      }
    },
    "Your project": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your project"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的项目"
          }
        }
      }
    },
    "Munie creates a private project for you.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie creates a private project for you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie 会为你创建一个专用项目。"
          }
        }
      }
    },
    "Choose Another Project…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Another Project…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择其他项目…"
          }
        }
      }
    },
    "Connect your iPhone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your iPhone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接你的 iPhone"
          }
        }
      }
    },
    "Check that both screens show this number:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that both screens show this number:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认两端显示的数字相同："
          }
        }
      }
    },
    "Allow iPhone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow iPhone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 iPhone 连接"
          }
        }
      }
    },
    "Decline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decline"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝"
          }
        }
      }
    },
    "Open Munie on your iPhone near this Mac and choose this Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Munie on your iPhone near this Mac and choose this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 附近打开 iPhone 上的 Munie，并选择这台 Mac。"
          }
        }
      }
    },
    "Nearby discovery is unavailable. Check Local Network access and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby discovery is unavailable. Check Local Network access and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附近发现暂不可用。请检查本地网络权限并重试。"
          }
        }
      }
    },
    "Retry Discovery": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry Discovery"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试发现"
          }
        }
      }
    },
    "Start Munie": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Munie"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动 Munie"
          }
        }
      }
    },
    "Retry Stopping": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry Stopping"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试停止"
          }
        }
      }
    },
    "Stop Munie": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Munie"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止 Munie"
          }
        }
      }
    },
    "Refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新"
          }
        }
      }
    },
    "Open Munie": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Munie"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Munie"
          }
        }
      }
    },
    "Quit Munie": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Munie"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 Munie"
          }
        }
      }
    },
    "This version connects nearby. Connecting away from home is not ready yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version connects nearby. Connecting away from home is not ready yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本支持附近连接，外出连接尚未就绪。"
          }
        }
      }
    },
    "Connect this Mac to Wi-Fi or Ethernet, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect this Mac to Wi-Fi or Ethernet, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将这台 Mac 接入 Wi-Fi 或以太网，然后重试。"
          }
        }
      }
    },
    "Account status is unavailable. You can try signing in again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account status is unavailable. You can try signing in again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法获取账户状态，你可以尝试重新登录。"
          }
        }
      }
    },
    "Your iPhone is waiting for confirmation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone is waiting for confirmation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iPhone 正在等待确认"
          }
        }
      }
    },
    "iPhone confirmation needed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone confirmation needed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要确认 iPhone 连接"
          }
        }
      }
    },
    "Changing projects restarts the Mac service and may stop active work.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing projects restarts the Mac service and may stop active work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换项目会重新启动 Mac 服务，并可能停止正在执行的工作。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
