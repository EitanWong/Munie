    "This removes all current iPhone pairings and disconnects them. The Mac service restarts and active work may stop. Pair again to reconnect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes all current iPhone pairings and disconnects them. The Mac service restarts and active work may stop. Pair again to reconnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除当前所有 iPhone 配对并断开连接。Mac 服务将重新启动，正在执行的工作可能停止。重新配对后才能再次连接。"
          }
        }
      }
    },
    "Paired iPhone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired iPhone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对的 iPhone"
          }
        }
      }
    },
