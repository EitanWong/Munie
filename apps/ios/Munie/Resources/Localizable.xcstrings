{
  "sourceLanguage": "en",
  "strings": {
    "Munie": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie"
          }
        }
      }
    },
    "Storage unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储不可用"
          }
        }
      }
    },
    "Munie could not open local storage. Reopen the app to try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie could not open local storage. Reopen the app to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie 无法打开本地存储。请重新打开 App 再试。"
          }
        }
      }
    },
    "Write something before saving.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write something before saving."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先输入内容再保存。"
          }
        }
      }
    },
    "Keep each capture within 10,000 characters.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep each capture within 10,000 characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每条记录请勿超过 10,000 个字符。"
          }
        }
      }
    },
    "The saved data could not be read. It has not been overwritten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved data could not be read. It has not been overwritten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取已保存的数据，原文件未被覆盖。"
          }
        }
      }
    },
    "This capture no longer exists. Reload your captures.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This capture no longer exists. Reload your captures."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条记录已不存在，请重新加载。"
          }
        }
      }
    },
    "The storage operation failed. Your draft is still available. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The storage operation failed. Your draft is still available. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储操作失败，草稿仍在，请重试。"
          }
        }
      }
    },
