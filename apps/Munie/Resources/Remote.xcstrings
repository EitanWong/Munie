            "value": "这不会取消 Mac 已接受的任务。开始新请求前请先核对其状态。"
          }
        }
      }
    },
    "This iPhone has no authorized projects. Choose projects on your Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone has no authorized projects. Choose projects on your Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 尚未获得项目授权。请在 Mac 上选择项目。"
          }
        }
      }
    },
    "This removes the connection from this iPhone. Revoke the device on your Mac to remove its access. Existing Mac work is not cancelled.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the connection from this iPhone. Revoke the device on your Mac to remove its access. Existing Mac work is not cancelled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作会从 iPhone 移除连接。若要移除其访问权限，请在 Mac 上撤销此设备。Mac 上的现有任务不会取消。"
          }
        }
      }
    },
    "Use text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use text"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用文字"
          }
        }
      }
    },
    "Verify this pairing ID on both devices:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify this pairing ID on both devices:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请核对两台设备上相同的配对标识："
          }
        }
      }
    },
    "Waiting for confirmation on your Mac…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for confirmation on your Mac…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待 Mac 确认…"
          }
        }
      }
    },
    "Without configured remote push, updates are checked while Munie is open. iOS may suspend the app in the background. Open Munie to recover authoritative state.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without configured remote push, updates are checked while Munie is open. iOS may suspend the app in the background. Open Munie to recover authoritative state."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未配置远程推送时，仅在 Munie 打开期间检查更新。iOS 可能在后台暂停 App。重新打开 Munie 即可核对主机的权威状态。"
          }
        }
      }
    },
    "Working directory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working directory"
