{
  "sourceLanguage": "en",
  "strings": {
    "Munie could not read the API key from the Keychain.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie could not read the API key from the Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie 无法从钥匙串读取 API 密钥。"
          }
        }
      }
    },
    "Munie could not load the official API key into Codex.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie could not load the official API key into Codex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie 无法将 OpenAI 官方 API 密钥载入 Codex。"
          }
        }
      }
    },
    "Enter an API key without spaces or line breaks.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an API key without spaces or line breaks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入不含空格或换行的 API 密钥。"
          }
        }
      }
    },
    "Munie could not update the API key in the Keychain.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie could not update the API key in the Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Munie 无法更新钥匙串中的 API 密钥。"
