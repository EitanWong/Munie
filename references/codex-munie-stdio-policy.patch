+struct RestrictedExtensionRequirementsConflict;
+
+fn verify_restricted_extension_requirements(config: &Config) -> std::io::Result<()> {
+    if !codex_protocol::shell_environment::external_extensions_disabled_for_process() {
+        return Ok(());
+    }
+    let requirements = config.config_layer_stack.requirements();
+    if requirements.managed_hooks.is_some()
+        || requirements
+            .mcp_servers
+            .as_ref()
+            .is_some_and(|allowlist| !allowlist.value.is_empty())
+    {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::PermissionDenied,
+            RestrictedExtensionRequirementsConflict,
+        ));
+    }
+    Ok(())
+}
