{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a short request only when you start recording. Munie does not save the audio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你开始录音时录制简短请求。Munie 不保存音频。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn your short recording into editable task text using on-device speech recognition."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用设备端语音识别，将短语音转换为可编辑的任务文字。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the pairing invitation displayed on your Mac. Camera use is optional."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描 Mac 显示的配对邀请。你也可以选择不使用相机。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
