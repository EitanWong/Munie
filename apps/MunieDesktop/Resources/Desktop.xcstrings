    "Pairing allows your iPhone to connect. It does not mean the iPhone is online now.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing allows your iPhone to connect. It does not mean the iPhone is online now."
