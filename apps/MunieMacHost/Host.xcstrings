      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop service"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止服务"
          }
        }
      }
    },
    "Open at login": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at login"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时打开"
          }
        }
      }
    },
