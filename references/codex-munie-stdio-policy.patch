 use std::collections::HashMap;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+
+// Munie modification: an app-server can opt out of loading external extension processes.
+static EXTERNAL_EXTENSIONS_DISABLED: AtomicBool = AtomicBool::new(false);
+
+pub fn disable_external_extensions_for_process() {
+    EXTERNAL_EXTENSIONS_DISABLED.store(true, Ordering::Relaxed);
+}
+
+pub fn external_extensions_disabled_for_process() -> bool {
+    EXTERNAL_EXTENSIONS_DISABLED.load(Ordering::Relaxed)
+}
 
